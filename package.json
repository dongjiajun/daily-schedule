{
  "private": true,
  "name": "daily-schedule",
  "packageManager": "pnpm@11.15.0",
  "scripts": {
    "build": "turbo run build --output-logs=errors-only",
    "dev": "turbo run dev",
    "lint": "turbo run lint --output-logs=errors-only",
    "test": "turbo run test --output-logs=errors-only",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual",
    "test:e2e:ui": "playwright test --ui",
    "verify": "turbo run verify --output-logs=errors-only",
    "verify:frontend": "turbo run verify --filter=frontend --output-logs=errors-only",
    "verify:miniprogram": "turbo run verify --filter=@daily-schedule/miniprogram --output-logs=errors-only",
    "docs:check": "node scripts/docs-check.mjs",
    "ui:check": "node scripts/ui-check.mjs",
    "openspec:check": "node scripts/openspec-check.mjs"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.15.0",
    "@playwright/test": "^1.62.0",
    "turbo": "^2.6.3"
  }
}
